// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="org.quickshell$"
    open-floating true
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="^zen$" title="^Picture-in-Picture$"
    open-floating true
    open-focused false
    open-on-output "DP-1"
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=32 y=32 relative-to="bottom-right"
}

// @id=dms_rule_2 @name=
window-rule {
    match title="^Steam Big Picture$"
    open-fullscreen true
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^zen$"
    draw-border-with-background false
}

// @id=dms_rule_4 @name=
window-rule {
    match app-id="^steam_app_\\d+$"
    match app-id="^Minecraft"
    open-fullscreen true
    open-on-workspace "gaming"
}

// @id=dms_rule_5 @name=
window-rule {
    match app-id="^discord$"
    match app-id="^Element$"
    match app-id="^elecwhat$"
    open-on-workspace "chat"
}

// @id=dms_rule_6 @name=
window-rule {
    match app-id="^feishin$"
    match app-id="^Spotify$"
    open-on-workspace "media"
}

// @id=dms_rule_7 @name=
window-rule {
    match app-id="^steam$"
    open-on-workspace "gaming"
}

// @id=dms_rule_8 @name=
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
